{
  "name": "social-machine",
  "version": "0.1.0",
  "private": false,
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.5",
    "braces": "https://github.com/luisroquette-labs/braces/archive/675def268ad3a16e0fc268224f101dc82f347df7.tar.gz"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "session-audit": "sh scripts/session-audit.sh",
    "audit:public-release": "sh scripts/audit-public-release.sh",
    "audit:runtime": "npm audit --omit=dev",
    "validate:product": "node scripts/validate-product-site.mjs",
    "preflight:ci": "npm run audit:public-release && npm run audit:runtime && npm run validate:product && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.127",
    "@ai-sdk/deepseek": "^2.0.71",
    "@ai-sdk/google": "^3.0.130",
    "@base-ui/react": "^1.4.0",
    "@openrouter/ai-sdk-provider": "2.10.0",
    "@remotion/lambda": "^4.0.448",
    "@sentry/nextjs": "^10.50.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "@vercel/functions": "^3.4.4",
    "ai": "^6.0.300",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.8.0",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
